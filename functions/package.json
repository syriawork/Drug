{
  "name": "drug-manager-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated Firebase Cloud Functions backend for Drug Manager.",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/authorization.test.cjs",
    "test:emulator": "node ../emulator-lab/scripts/run-functions-authorization-tests.mjs"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
