# Drug Manager — Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# Never commit .env files containing real credentials.
# The application reads these variables from process.env at startup.

# ── Firebase Authentication ──────────────────────────────────────────

# Firebase Web API Key (public client configuration, NOT a secret).
# Required in production mode. Optional when FIREBASE_AUTH_EMULATOR_HOST is set.
# Development: leave unset (emulator uses a fake key).
# Production: set to your Firebase project's Web API Key.
FIREBASE_API_KEY=

# Firebase project ID.
# Required in production mode. Optional when FIREBASE_AUTH_EMULATOR_HOST is set.
# Development: leave unset (emulator uses 'demo-drug-project').
# Production: set to your Firebase project ID.
FIREBASE_PROJECT_ID=

# Firebase Auth Emulator host (loopback only: localhost, 127.0.0.1, ::1).
# Optional. When set, Auth targets the local emulator (development/testing only).
# Production: must be unset.
FIREBASE_AUTH_EMULATOR_HOST=

# HTTPS override for Identity Toolkit endpoint (optional, staging/test only).
# Must be an approved HTTPS Firebase endpoint. Leave unset for production default.
FIREBASE_AUTH_BASE_URL=

# HTTPS override for Secure Token endpoint (optional, staging/test only).
# Must be an approved HTTPS Firebase endpoint. Leave unset for production default.
FIREBASE_TOKEN_BASE_URL=

# ── Firestore REST ───────────────────────────────────────────────────

# Firestore Emulator host (e.g., 127.0.0.1:8080).
# Optional. When set, Firestore targets the local emulator.
# Production: must be unset (or set FIRESTORE_ALLOW_REMOTE_TARGET=true).
FIRESTORE_EMULATOR_HOST=

# Firestore REST base URL override (test harness / staging only).
# Must point to a loopback host unless FIRESTORE_ALLOW_REMOTE_TARGET=true.
FIRESTORE_BASE_URL=

# Firestore database ID (default: (default)).
# Optional. Normally left unset.
FIRESTORE_DATABASE_ID=

# Firestore REST request timeout in milliseconds (default: 15000).
# Optional.
FIRESTORE_REQUEST_TIMEOUT_MS=

# Explicit opt-in for remote (non-loopback) Firestore targets.
# Set to 'true' ONLY for production deployment with a real Firebase project.
# Default: unset (remote targets are blocked).
FIRESTORE_ALLOW_REMOTE_TARGET=